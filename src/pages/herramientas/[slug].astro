---
import type { App } from '../../types';

export async function getStaticPaths() {
  const res = await fetch("https://queesia.com/api/obtener_datos.php");
  const data: { tools: App [] } = await res.json();

  return data.tools.map((app: App) => ({
    params: { slug: app.id.toString() },
    props: { app },
  }));
}

// Acceder a los datos pasados como `props`
const { app }: { app: App } = Astro.props;
---

<h1>{app.name}</h1>
<p>{app.short_description}</p>
<a href={app.url} target="_blank">Visitar</a>
