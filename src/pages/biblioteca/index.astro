---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Biblioteca de inteligencia artificial | Queesia"
  description="Consulta documentos sobre inteligencia artificial, gobernanza, ética, regulación, riesgos y otros temas relevantes para comprender su desarrollo."
>

    <div
    class="biblioteca-bg-global pointer-events-none fixed inset-0 -z-10"
    aria-hidden="true"
  >
    <div class="biblioteca-bg-mask-y">
      <div class="biblioteca-bg-mask-x">
        <img
          src="/src/assets/bg_amorph.svg"
          class="biblioteca-bg-image"
          alt=""
        />
      </div>
    </div>
  </div>


  <section class="hero-biblioteca">
  <div class="hero-biblioteca-deco" aria-hidden="true">
    <div class="hero-orb hero-orb-left"></div>
    <div class="hero-orb hero-orb-right"></div>
    <div class="hero-half hero-half-left"></div>
    <div class="hero-half hero-half-right"></div>
  </div>

  <div class="container">

      <p class="eyebrow">Biblioteca</p>
      <h1>Documentos clave sobre inteligencia artificial</h1>
      <p class="lead">
        Una selección curada de materiales de referencia sobre gobernanza, ética,
        regulación, riesgos y derechos vinculados a la inteligencia artificial.
      </p>
    </div>
  </section>

  <section class="toolbar-section">
    <div class="container">
      <div class="toolbar">
        <div class="search-wrap">
          <span class="search-icon">⌕</span>
          <input
            id="searchInput"
            type="text"
            placeholder="Buscar documento, tema, tag o institución..."
          />
        </div>

        <div class="select-wrap">
          <select id="institutionFilter">
            <option value="">Todas las entidades</option>
          </select>
        </div>
      </div>

      <div class="type-tabs-wrap">
        <div class="type-tabs" id="typeTabs">
          <button class="tab-btn active" data-type="">Todos</button>
        </div>
        <div class="type-meta" id="typeMeta"></div>
      </div>
    </div>
  </section>

  <section class="biblioteca-destacada">
    <div class="container">
      <div id="loadingState" class="loading-state">Cargando biblioteca...</div>
      <div id="featuredContainer"></div>
    </div>
  </section>

  <section class="biblioteca-grid-section">
    <div class="container">
      <div class="section-heading" id="sectionHeading">
        <h2 id="sectionTitle">Más documentos</h2>
        <p id="sectionDescription">
          Otros recursos relevantes para ampliar la consulta sobre regulación,
          riesgos, derechos y uso responsable de la IA.
        </p>
      </div>

      <div id="docsGrid" class="biblioteca-grid"></div>

      <div id="emptyState" class="empty-state biblioteca-hidden">
        No encontramos documentos con los filtros actuales. Intenta con otra búsqueda o selecciona otro filtro.
      </div>
    </div>
  </section>

  <script is:inline>
    const API_URL = "https://queesia.com/api/biblioteca/list.php";

    const state = {
      allItems: [],
      filteredItems: [],
      currentSearch: "",
      currentInstitution: "",
      currentType: ""
    };

    const loadingState = document.getElementById("loadingState");
    const featuredContainer = document.getElementById("featuredContainer");
    const docsGrid = document.getElementById("docsGrid");
    const emptyState = document.getElementById("emptyState");
    const searchInput = document.getElementById("searchInput");
    const institutionFilter = document.getElementById("institutionFilter");
    const typeTabs = document.getElementById("typeTabs");
    const typeMeta = document.getElementById("typeMeta");
    const sectionTitle = document.getElementById("sectionTitle");
    const sectionDescription = document.getElementById("sectionDescription");

    function normalizeText(value) {
      return (value || "")
        .toString()
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "");
    }

    function escapeHtml(text) {
      const div = document.createElement("div");
      div.textContent = text ?? "";
      return div.innerHTML;
    }

    function createFeaturedCard(item) {
      const institution = item.institution || "";
      const year = item.year ? String(item.year) : "";
      const type = item.resource_type || "Documento";
      const topic = item.topic || "";
      const summary = item.summary || "Sin resumen disponible.";
      const tags = Array.isArray(item.tags) ? item.tags : [];

      return `
        <article class="destacado-card">
          <div class="destacado-meta">
            ${institution ? `<span>${escapeHtml(institution)}</span>` : ""}
            ${institution && year ? `<span>•</span>` : ""}
            ${year ? `<span>${escapeHtml(year)}</span>` : ""}
            ${(institution || year) && type ? `<span>•</span>` : ""}
            ${type ? `<span>${escapeHtml(type)}</span>` : ""}
          </div>

          <h2>${escapeHtml(item.title || "Sin título")}</h2>
          ${topic ? `<p class="destacado-topic">${escapeHtml(topic)}</p>` : ""}
          <p class="destacado-summary">${escapeHtml(summary)}</p>

          ${tags.length ? `
            <div class="tags">
              ${tags.map(tag => `<span class="tag">${escapeHtml(tag)}</span>`).join("")}
            </div>
          ` : ""}

                    <div class="actions">
            ${item.document_url ? `
              <a
                href="${escapeHtml(item.document_url)}"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-primary"
              >
                Ver documento
              </a>
            ` : ""}

            ${item.infographic_url ? `
              <a
                href="${escapeHtml(item.infographic_url)}"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-secondary"
              >
                Ver infografía
              </a>
            ` : ""}

            ${item.multimedia_url ? `
              <a
                href="${escapeHtml(item.multimedia_url)}"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-secondary"
              >
                Ver multimedia
              </a>
            ` : ""}
          </div>
        </article>
      `;
    }

    function createDocCard(item) {
      const institution = item.institution || "";
      const year = item.year ? String(item.year) : "";
      const type = item.resource_type || "Documento";
      const topic = item.topic || "";
      const summary = item.summary || "Sin resumen disponible.";
      const tags = Array.isArray(item.tags) ? item.tags : [];

      return `
        <article class="doc-card">
          <div class="doc-meta">
            ${institution ? `<span>${escapeHtml(institution)}</span>` : ""}
            ${institution && year ? `<span>•</span>` : ""}
            ${year ? `<span>${escapeHtml(year)}</span>` : ""}
            ${(institution || year) && type ? `<span>•</span>` : ""}
            ${type ? `<span>${escapeHtml(type)}</span>` : ""}
          </div>

          <h3>${escapeHtml(item.title || "Sin título")}</h3>
          ${topic ? `<p class="doc-topic">${escapeHtml(topic)}</p>` : ""}
          <p class="doc-summary">${escapeHtml(summary)}</p>

          ${tags.length ? `
            <div class="tags">
              ${tags.map(tag => `<span class="tag">${escapeHtml(tag)}</span>`).join("")}
            </div>
          ` : ""}

                    <div class="actions">
            ${item.document_url ? `
              <a
                href="${escapeHtml(item.document_url)}"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-primary btn-small"
              >
                Ver documento
              </a>
            ` : ""}

            ${item.infographic_url ? `
              <a
                href="${escapeHtml(item.infographic_url)}"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-secondary btn-small"
              >
                Ver infografía
              </a>
            ` : ""}

            ${item.multimedia_url ? `
              <a
                href="${escapeHtml(item.multimedia_url)}"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-secondary btn-small"
              >
                Ver multimedia
              </a>
            ` : ""}
          </div>
        </article>
      `;
    }

    function populateInstitutionFilter(items) {
      const institutions = [...new Set(
        items
          .map(item => (item.institution || "").trim())
          .filter(Boolean)
      )].sort((a, b) => a.localeCompare(b, "es"));

      institutionFilter.innerHTML = `
        <option value="">Todas las entidades</option>
        ${institutions.map(inst => `<option value="${escapeHtml(inst)}">${escapeHtml(inst)}</option>`).join("")}
      `;
    }

        function populateTypeTabs(items) {
      const preferredOrder = ["Artículo", "Carta", "Documento", "Tesis"];

      const foundTypes = new Set(
        items
          .map(item => (item.resource_type || "").trim())
          .filter(Boolean)
      );

      const orderedTypes = preferredOrder.filter(type => foundTypes.has(type));

      typeTabs.innerHTML = `
        <button class="tab-btn active" data-type="">Todos</button>
        ${orderedTypes.map(type => `<button class="tab-btn" data-type="${escapeHtml(type)}">${escapeHtml(type)}</button>`).join("")}
      `;

      [...typeTabs.querySelectorAll(".tab-btn")].forEach(btn => {
        btn.addEventListener("click", () => {
          [...typeTabs.querySelectorAll(".tab-btn")].forEach(b => b.classList.remove("active"));
          btn.classList.add("active");
          state.currentType = btn.dataset.type || "";
          applyFilters();
        });
      });
    }

    function updateSectionHeading(totalItems) {
      const currentType = (state.currentType || "").trim();

      if (!currentType) {
        sectionTitle.textContent = "Más documentos";
        sectionDescription.textContent = "Otros recursos relevantes para ampliar la consulta sobre regulación, riesgos, derechos y uso responsable de la IA.";
      } else {
        sectionTitle.textContent = currentType;
        sectionDescription.textContent = totalItems === 1
          ? `Se encontró 1 recurso en la categoría ${currentType.toLowerCase()}.`
          : `Se encontraron ${totalItems} recursos en la categoría ${currentType.toLowerCase()}.`;
      }

      if (typeMeta) {
        typeMeta.textContent = totalItems === 1
          ? "1 resultado"
          : `${totalItems} resultados`;
      }
    }

    function applyFilters() {
      const search = normalizeText(state.currentSearch);
      const institution = normalizeText(state.currentInstitution);
      const type = normalizeText(state.currentType);

      state.filteredItems = state.allItems.filter(item => {
                const haystack = normalizeText([
          item.title,
          item.institution,
          item.topic,
          item.summary,
          item.resource_type,
          item.multimedia_url,
          ...(Array.isArray(item.tags) ? item.tags : [])
        ].join(" "));

        const matchesSearch = !search || haystack.includes(search);
        const matchesInstitution = !institution || normalizeText(item.institution) === institution;
        const matchesType = !type || normalizeText(item.resource_type) === type;

        return matchesSearch && matchesInstitution && matchesType;
      });

      renderItems();
    }

    function renderItems() {
      const items = state.filteredItems.slice();
      updateSectionHeading(items.length);

      const allowFeatured = !state.currentType;
      const featuredItem = allowFeatured
        ? (items.find(item => Number(item.featured) === 1) || null)
        : null;

      const secondaryItems = items.filter(item => !featuredItem || Number(item.id) !== Number(featuredItem.id));

      if (featuredItem) {
        featuredContainer.innerHTML = createFeaturedCard(featuredItem);
      } else {
        featuredContainer.innerHTML = "";
      }

      if (secondaryItems.length) {
        docsGrid.innerHTML = secondaryItems.map(createDocCard).join("");
        docsGrid.classList.remove("biblioteca-hidden");
        emptyState.classList.add("biblioteca-hidden");
      } else if (!featuredItem) {
        docsGrid.innerHTML = "";
        docsGrid.classList.add("biblioteca-hidden");
        emptyState.classList.remove("biblioteca-hidden");
      } else {
        docsGrid.innerHTML = "";
        docsGrid.classList.add("biblioteca-hidden");
        emptyState.classList.add("biblioteca-hidden");
      }
    }

    async function loadBiblioteca() {
      try {
        const response = await fetch(API_URL, { cache: "no-store" });

        if (!response.ok) {
          throw new Error(`HTTP ${response.status}`);
        }

        const data = await response.json();
        const items = Array.isArray(data.items) ? data.items : [];

        state.allItems = items;
        populateInstitutionFilter(items);
        populateTypeTabs(items);
        applyFilters();
      } catch (error) {
        console.error("Error al cargar biblioteca:", error);
        featuredContainer.innerHTML = "";
        docsGrid.classList.add("biblioteca-hidden");
        emptyState.classList.remove("biblioteca-hidden");
        emptyState.textContent = "No fue posible cargar la biblioteca en este momento.";
      } finally {
        loadingState.classList.add("biblioteca-hidden");
      }
    }

    searchInput?.addEventListener("input", (e) => {
      state.currentSearch = e.target.value || "";
      applyFilters();
    });

    institutionFilter?.addEventListener("change", (e) => {
      state.currentInstitution = e.target.value || "";
      applyFilters();
    });

    loadBiblioteca();
  </script>
</BaseLayout>

<style is:global>
  .biblioteca-bg-global {
  background: transparent;
}

.biblioteca-bg-mask-y {
  width: 100%;
  height: 100%;
  mask-image: linear-gradient(
    to bottom,
    rgba(0, 0, 0, 0),
    #000 12%,
    #000 88%,
    rgba(0, 0, 0, 0)
  );
  -webkit-mask-image: linear-gradient(
    to bottom,
    rgba(0, 0, 0, 0),
    #000 12%,
    #000 88%,
    rgba(0, 0, 0, 0)
  );
  mask-repeat: no-repeat;
  -webkit-mask-repeat: no-repeat;
}

.biblioteca-bg-mask-x {
  width: 100%;
  height: 100%;
  mask-image: linear-gradient(
    to right,
    rgba(0, 0, 0, 0),
    #000 10%,
    #000 90%,
    rgba(0, 0, 0, 0)
  );
  -webkit-mask-image: linear-gradient(
    to right,
    rgba(0, 0, 0, 0),
    #000 10%,
    #000 90%,
    rgba(0, 0, 0, 0)
  );
  mask-repeat: no-repeat;
  -webkit-mask-repeat: no-repeat;
}

.biblioteca-bg-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0.22;
}

.hero-biblioteca-deco {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
}

.hero-orb {
  position: absolute;
  border-radius: 999px;
  ring: 1px solid rgba(255,255,255,.4);
  background: transparent;
  backdrop-filter: blur(2px);
  mix-blend-mode: soft-light;
  border: 1px solid rgba(255,255,255,0.3);
}

.hero-orb-left {
  top: -36px;
  left: -64px;
  width: 280px;
  height: 280px;
}

.hero-orb-right {
  bottom: -48px;
  right: -70px;
  width: 260px;
  height: 260px;
}

.hero-half {
  position: absolute;
  border: 1px solid rgba(255,255,255,0.28);
  background: transparent;
  mix-blend-mode: soft-light;
}

.hero-half-left {
  top: 72px;
  left: -88px;
  width: 230px;
  height: 230px;
  border-radius: 999px 0 0 999px;
}

.hero-half-right {
  bottom: 30px;
  right: -88px;
  width: 230px;
  height: 230px;
  border-radius: 999px 0 0 999px;
}

.hero-biblioteca > .container {
  position: relative;
  z-index: 1;
}

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  .hero-biblioteca {
  position: relative;
  overflow: hidden;
  padding: 5.25rem 0 2.5rem;
  background: transparent;
}

  .eyebrow {
    display: inline-block;
    margin-bottom: 0.75rem;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #5b6ee1;
  }

  .hero-biblioteca h1 {
  margin: 0;
  font-size: clamp(2rem, 4vw, 3.3rem);
  line-height: 1.1;
  color: rgb(31, 41, 55);
  max-width: 820px;
  font-family: "Montserrat", sans-serif;
  font-style: normal;
  font-weight: 500;
  letter-spacing: -0.02em;
  text-wrap: balance;
}

  .lead {
    max-width: 760px;
    margin-top: 1rem;
    font-size: 1.08rem;
    line-height: 1.7;
    color: rgb(75, 85, 99);
    font-family: "Raleway", ui-sans-serif, system-ui, sans-serif;
  }

  .toolbar-section {
  padding: 0.75rem 0 1.5rem;
  background: transparent;
}

  .toolbar {
    display: grid;
    grid-template-columns: 1.5fr 0.8fr;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .search-wrap,
  .select-wrap {
    position: relative;
  }

  .search-wrap input,
  .select-wrap select {
    width: 100%;
    height: 56px;
    border-radius: 16px;
    border: 1px solid rgba(15, 23, 42, 0.08);
    background: rgba(255,255,255,0.88);
    font-size: 15px;
    padding: 0 16px;
    color: rgb(31, 41, 55);
    outline: none;
    font-family: "Raleway", ui-sans-serif, system-ui, sans-serif;
  }

  .search-wrap input {
    padding-left: 42px;
  }

  .search-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: #7b8496;
    font-size: 16px;
    pointer-events: none;
  }

  .type-tabs {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    padding: 0.6rem;
    border-radius: 16px;
    background: rgba(255,255,255,0.82);
    border: 1px solid rgba(15, 23, 42, 0.06);
  }

  .tab-btn {
    border: none;
    background: transparent;
    padding: 0.8rem 1rem;
    border-radius: 999px;
    font-size: 0.95rem;
    color: #4b5563;
    cursor: pointer;
    font-weight: 700;
    font-family: "Raleway", ui-sans-serif, system-ui, sans-serif;
  }

  .tab-btn.active {
    background: #2f5bea;
    color: #fff;
    box-shadow: 0 10px 20px rgba(47, 91, 234, 0.22);
  }

  .biblioteca-destacada {
  padding: 0.25rem 0 2rem;
  background: transparent;
}

  .destacado-card {
    max-width: 860px;
    background: rgba(255,255,255,0.82);
    backdrop-filter: blur(10px);
    border: 1px solid #d9dff8;
    border-radius: 24px;
    padding: 2rem;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
  }

  .destacado-meta,
  .doc-meta {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    font-size: 0.92rem;
    color: #64748b;
    font-weight: 600;
    font-family: "Raleway", ui-sans-serif, system-ui, sans-serif;
  }

.destacado-card h2 {
  margin: 0.9rem 0 0.35rem;
  font-size: 1.85rem;
  color: #111827;
  font-family: "Montserrat", sans-serif;
  font-style: normal;
  font-weight: 600;
}

  .destacado-topic,
  .doc-topic {
    margin: 0 0 0.9rem;
    font-weight: 700;
    color: #5b6ee1;
    font-family: "Raleway", ui-sans-serif, system-ui, sans-serif;
  }

  .destacado-summary,
  .doc-summary {
    color: rgb(75, 85, 99);
    line-height: 1.7;
    font-family: "Raleway", ui-sans-serif, system-ui, sans-serif;
  }

  .destacado-summary {
    max-width: 720px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1.2rem 0 1.4rem;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    padding: 0.42rem 0.8rem;
    border-radius: 999px;
    background: #eef1ff;
    color: #4c5a78;
    font-size: 0.84rem;
    font-weight: 600;
    font-family: "Raleway", ui-sans-serif, system-ui, sans-serif;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1rem;
    align-items: center;
  }

  .btn-primary,
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.2rem;
    border-radius: 999px;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    font-family: "Raleway", ui-sans-serif, system-ui, sans-serif;
  }

  .btn-primary {
    background: #2f5bea;
    color: #ffffff;
  }

  .btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 20px rgba(47, 91, 234, 0.20);
  }

  .btn-secondary {
    background: #ffffff;
    color: #41506b;
    border: 1px solid #d9dff8;
  }

  .btn-secondary:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 20px rgba(65, 80, 107, 0.10);
    background: #f4f6ff;
  }

  .biblioteca-grid-section {
  padding: 0.5rem 0 4rem;
  background: transparent;
}

  .section-heading {
    margin-bottom: 1.5rem;
  }

  .section-heading h2 {
  margin: 0 0 0.4rem;
  font-size: 1.8rem;
  color: #111827;
  font-family: "Montserrat", sans-serif;
  font-style: normal;
  font-weight: 600;
}

  .section-heading p {
    margin: 0;
    color: #6b7280;
    line-height: 1.6;
    max-width: 760px;
    font-family: "Raleway", ui-sans-serif, system-ui, sans-serif;
  }

  .biblioteca-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .doc-card {
    background: rgba(255,255,255,0.86);
    backdrop-filter: blur(8px);
    border: 1px solid #d9dff8;
    border-radius: 20px;
    padding: 1.35rem;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.04);
  }

  .doc-card h3 {
  margin: 0.8rem 0 0.45rem;
  font-size: 1.15rem;
  line-height: 1.35;
  color: #111827;
  font-family: "Montserrat", sans-serif;
  font-style: normal;
  font-weight: 600;
}

  .btn-small {
    padding: 0.72rem 1rem;
    font-size: 0.94rem;
  }

  .loading-state,
  .empty-state {
    background: #ffffff;
    border: 1px solid #d9dff8;
    border-radius: 20px;
    padding: 1.5rem;
    color: rgb(75, 85, 99);
    line-height: 1.7;
    font-family: "Raleway", ui-sans-serif, system-ui, sans-serif;
  }

    .biblioteca-hidden {
    display: none !important;
  }

  @media (max-width: 1000px) {
    .biblioteca-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .toolbar {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 900px) {
    .hero-biblioteca {
      padding: 6.25rem 0 2rem;
    }

    .biblioteca-destacada {
      padding: 1rem 0 1.5rem;
    }

    .biblioteca-grid {
