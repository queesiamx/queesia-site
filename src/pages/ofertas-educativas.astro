---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Cursos y ofertas educativas de IA | Queesia"
  description="Explora cursos, diplomados, certificaciones y programas relacionados con inteligencia artificial, tecnología, innovación y habilidades digitales."
>
  <div
    class="ofertas-bg-global pointer-events-none fixed inset-0 -z-10"
    aria-hidden="true"
  >
    <div class="ofertas-bg-mask-y">
      <div class="ofertas-bg-mask-x">
        <img
          src="/src/assets/bg_amorph.svg"
          class="ofertas-bg-image"
          alt=""
        />
      </div>
    </div>
  </div>

  <section class="hero-ofertas">
    <div class="hero-ofertas-deco" aria-hidden="true">
      <div class="hero-orb hero-orb-left"></div>
      <div class="hero-orb hero-orb-right"></div>
      <div class="hero-half hero-half-left"></div>
      <div class="hero-half hero-half-right"></div>
    </div>

    <div class="container">
      <div class="hero-content">
        <div class="hero-copy">

          <p class="eyebrow">Ofertas educativas</p>

          <h1>Explora programas de Innovación y Habilidades Digitales.</h1>

          <p class="lead">
            Descubre cursos, diplomados y programas vinculados con inteligencia artificial, tecnología e innovación, compartidos por instituciones que buscan acercar formación relevante a la comunidad de Queesia. También está abierta para nuevas colaboraciones educativas.
          </p>

          <a href="/contacto" class="hero-link">
            Consultar opciones de difusión →
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="toolbar-section">
    <div class="container">
      <p class="toolbar-intro">
        Explora la oferta disponible y filtra por categoría o institución.
      </p>

      <div class="toolbar">
        <div class="search-wrap">
          <span class="search-icon">⌕</span>
          <input
            id="searchInput"
            type="text"
            placeholder="Buscar oferta educativa..."
          />
        </div>

        <div class="select-wrap">
          <select id="entityFilter">
            <option value="">Todas las entidades</option>
          </select>
        </div>
      </div>

      <div class="type-tabs" id="typeTabs">
        <button class="tab-btn active" data-category="">Todos</button>
      </div>
    </div>
  </section>

  <section class="ofertas-grid-section">
    <div class="container">
      <div id="loadingState" class="loading-state">Cargando ofertas educativas...</div>
      <div id="offersGrid" class="offers-grid"></div>

      <div id="emptyState" class="empty-state ofertas-hidden">
        No encontramos ofertas con los filtros actuales. Intenta con otra búsqueda o selecciona otro filtro.
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container">
      <div class="cta-card">
        <div class="cta-grid">
          <div class="cta-copy">
            <h2>¿Quieres publicar una oferta educativa en Queesia?</h2>
            <p>
              Esta sección también está abierta para universidades, centros de formación, academias
              e iniciativas educativas que deseen difundir cursos, diplomados, certificaciones o programas
              especializados.
            </p>
            <p>
              Si te interesa aparecer aquí, puedes contactarnos para conocer las opciones de publicación
              y colaboración disponibles.
            </p>
          </div>

          <div class="cta-actions">
            <a href="/contacto" class="cta-btn-primary">
              Quiero difundir una oferta educativa
            </a>
            <a href="/contacto" class="cta-btn-secondary">
              Hablar con Queesia
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    const API_URL = "https://queesia.com/api/ofertas-educativas/obtener_ofertas.php";

    const state = {
      allItems: [],
      filteredItems: [],
      currentSearch: "",
      currentEntity: "",
      currentCategory: ""
    };

    const loadingState = document.getElementById("loadingState");
    const offersGrid = document.getElementById("offersGrid");
    const emptyState = document.getElementById("emptyState");
    const searchInput = document.getElementById("searchInput");
    const entityFilter = document.getElementById("entityFilter");
    const typeTabs = document.getElementById("typeTabs");

    function normalizeText(value) {
      return (value || "")
        .toString()
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "");
    }

    function escapeHtml(text) {
      const div = document.createElement("div");
      div.textContent = text ?? "";
      return div.innerHTML;
    }

    function populateEntityFilter(itemsFromApi, entitiesFromApi) {
      const entities = Array.isArray(entitiesFromApi) && entitiesFromApi.length
        ? entitiesFromApi
        : [...new Set(
            itemsFromApi
              .map(item => (item.entity_name || "").trim())
              .filter(Boolean)
          )].sort((a, b) => a.localeCompare(b, "es"));

      entityFilter.innerHTML = `
        <option value="">Todas las entidades</option>
        ${entities.map(entity => `<option value="${escapeHtml(entity)}">${escapeHtml(entity)}</option>`).join("")}
      `;
    }

    function singularizeCategory(label) {
      const map = {
        "Cursos": "Curso",
        "Diplomados": "Diplomado",
        "Certificaciones": "Certificación",
        "Licenciaturas": "Licenciatura",
        "Maestrías": "Maestría"
      };
      return map[label] || label;
    }

    function populateTypeTabs(itemsFromApi, categoriesFromApi) {
      let categories = Array.isArray(categoriesFromApi) && categoriesFromApi.length
        ? categoriesFromApi
        : [...new Set(
            itemsFromApi
              .map(item => (item.category || "").trim())
              .filter(Boolean)
          )].sort((a, b) => a.localeCompare(b, "es"));

      categories = categories.map(cat => singularizeCategory(cat));

      typeTabs.innerHTML = `
        <button class="tab-btn active" data-category="">Todos</button>
        ${categories.map(category => `
          <button class="tab-btn" data-category="${escapeHtml(category)}">${escapeHtml(category)}</button>
        `).join("")}
      `;

      [...typeTabs.querySelectorAll(".tab-btn")].forEach(btn => {
        btn.addEventListener("click", () => {
          [...typeTabs.querySelectorAll(".tab-btn")].forEach(b => b.classList.remove("active"));
          btn.classList.add("active");
          state.currentCategory = btn.dataset.category || "";
          applyFilters();
        });
      });
    }

    function createOfferCard(item) {
      const type = item.category || "Programa";
      const institution = item.institution || item.entity_name || "Institución";
      const modality = item.modality || "Modalidad no especificada";
      const image = item.image_url || "/cursos-of-edu/helsinky.png";
      const description = item.short_description || "Sin descripción disponible.";
      const title = item.title || "Oferta educativa";
      const href = item.target_url || "#";
      const price = item.price_text || "";
      const duration = item.duration_text || "";
      const tags = Array.isArray(item.tags) ? item.tags : [];

      return `
        <article class="offer-card">
          <div class="offer-image-wrap">
            <img
              src="${escapeHtml(image)}"
              alt="${escapeHtml(title)}"
              class="offer-image"
            />

            <div class="offer-image-overlay"></div>

            <div class="offer-type-badge">
              ${escapeHtml(type.toUpperCase())}
            </div>
          </div>

          <div class="offer-body">
            <p class="offer-institution">${escapeHtml(institution)}</p>

            <h2 class="offer-title">${escapeHtml(title)}</h2>

            <p class="offer-modality">${escapeHtml(modality)}</p>

            <p class="offer-description">${escapeHtml(description)}</p>

            ${(price || duration || tags.length) ? `
              <div class="offer-meta-block">
                ${price ? `<span class="offer-chip">${escapeHtml(price)}</span>` : ""}
                ${duration ? `<span class="offer-chip">${escapeHtml(duration)}</span>` : ""}
                ${tags.slice(0, 3).map(tag => `<span class="offer-chip">${escapeHtml(tag)}</span>`).join("")}
              </div>
            ` : ""}

            <a
              href="${escapeHtml(href)}"
              target="_blank"
              rel="noopener noreferrer"
              class="offer-cta"
            >
              Ir al sitio
            </a>
          </div>
        </article>
      `;
    }

    function applyFilters() {
      const search = normalizeText(state.currentSearch);
      const entity = normalizeText(state.currentEntity);
      const category = normalizeText(state.currentCategory);

      state.filteredItems = state.allItems.filter(item => {
        const itemCategory = singularizeCategory(item.category || "");

        const haystack = normalizeText([
          item.title,
          item.institution,
          item.entity_name,
          item.category,
          item.modality,
          item.short_description,
          ...(Array.isArray(item.tags) ? item.tags : [])
        ].join(" "));

        const matchesSearch = !search || haystack.includes(search);
        const matchesEntity = !entity || normalizeText(item.entity_name) === entity;
        const matchesCategory = !category || normalizeText(itemCategory) === category;

        return matchesSearch && matchesEntity && matchesCategory;
      });

      renderOffers();
    }

    function renderOffers() {
      if (state.filteredItems.length) {
        offersGrid.innerHTML = state.filteredItems.map(createOfferCard).join("");
        offersGrid.classList.remove("ofertas-hidden");
        emptyState.classList.add("ofertas-hidden");
      } else {
        offersGrid.innerHTML = "";
        offersGrid.classList.add("ofertas-hidden");
        emptyState.classList.remove("ofertas-hidden");
      }
    }

    async function loadOffers() {
      try {
        const response = await fetch(API_URL, { cache: "no-store" });

        if (!response.ok) {
          throw new Error(`HTTP ${response.status}`);
        }

        const data = await response.json();

        const items = Array.isArray(data.data) ? data.data : [];
        const filters = data.filters || {};
        const categories = Array.isArray(filters.categories) ? filters.categories : [];
        const entities = Array.isArray(filters.entities) ? filters.entities : [];

        state.allItems = items;

        populateEntityFilter(items, entities);
        populateTypeTabs(items, categories);
        applyFilters();
      } catch (error) {
        console.error("Error al cargar ofertas educativas:", error);
        offersGrid.classList.add("ofertas-hidden");
        emptyState.classList.remove("ofertas-hidden");
        emptyState.textContent = "No fue posible cargar las ofertas educativas en este momento.";
      } finally {
        loadingState.classList.add("ofertas-hidden");
      }
    }

    searchInput?.addEventListener("input", (e) => {
      state.currentSearch = e.target.value || "";
      applyFilters();
    });

    entityFilter?.addEventListener("change", (e) => {
      state.currentEntity = e.target.value || "";
      applyFilters();
    });

    loadOffers();
  </script>
</BaseLayout>

<style is:global>
  .ofertas-bg-global {
    background: transparent;
  }

  .ofertas-bg-mask-y {
    width: 100%;
    height: 100%;
    mask-image: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0),
      #000 12%,
      #000 88%,
      rgba(0, 0, 0, 0)
    );
    -webkit-mask-image: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0),
      #000 12%,
      #000 88%,
      rgba(0, 0, 0, 0)
    );
    mask-repeat: no-repeat;
    -webkit-mask-repeat: no-repeat;
  }

  .ofertas-bg-mask-x {
    width: 100%;
    height: 100%;
    mask-image: linear-gradient(
      to right,
      rgba(0, 0, 0, 0),
      #000 10%,
      #000 90%,
      rgba(0, 0, 0, 0)
    );
    -webkit-mask-image: linear-gradient(
      to right,
      rgba(0, 0, 0, 0),
      #000 10%,
      #000 90%,
      rgba(0, 0, 0, 0)
    );
    mask-repeat: no-repeat;
    -webkit-mask-repeat: no-repeat;
  }

  .ofertas-bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.22;
  }

  .hero-ofertas-deco {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .hero-orb {
    position: absolute;
    border-radius: 999px;
    background: transparent;
    backdrop-filter: blur(2px);
    mix-blend-mode: soft-light;
    border: 1px solid rgba(255,255,255,0.3);
  }

  .hero-orb-left {
    top: -36px;
    left: -64px;
    width: 280px;
    height: 280px;
  }

  .hero-orb-right {
    bottom: -48px;
    right: -70px;
    width: 260px;
    height: 260px;
  }

  .hero-half {
    position: absolute;
    border: 1px solid rgba(255,255,255,0.28);
    background: transparent;
    mix-blend-mode: soft-light;
  }

  .hero-half-left {
    top: 72px;
    left: -88px;
    width: 230px;
    height: 230px;
    border-radius: 999px 0 0 999px;
  }

  .hero-half-right {
    bottom: 30px;
    right: -88px;
    width: 230px;
    height: 230px;
    border-radius: 999px 0 0 999px;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  .hero-ofertas {
    position: relative;
    overflow: hidden;
    padding: 5.25rem 0 2.5rem;
    background: transparent;
  }

  .hero-ofertas .container {
    position: relative;
    z-index: 1;
  }

  .hero-content {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .hero-copy {
    max-width: 820px;
  }

  .hero-pill {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.4);
    background: rgba(255,255,255,0.55);
    backdrop-filter: blur(10px);
    padding: 0.7rem 1rem;
    font-size: 0.92rem;
    color: #4b5563;
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.05);
    margin-bottom: 1rem;
    font-family: "Raleway", ui-sans-serif, system-ui, sans-serif;
  }

  .eyebrow {
    display: inline-block;
    margin-bottom: 0.75rem;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #5b6ee1;
    font-family: "Raleway", ui-sans-serif, system-ui, sans-serif;
  }

  .hero-ofertas h1 {
  margin: 0;
  font-size: clamp(2rem, 4vw, 3.3rem);
  line-height: 1.1;
  color: rgb(31, 41, 55);
  max-width: 820px;
  font-family: "Montserrat", sans-serif;
  font-style: normal;
  font-weight: 500;
  letter-spacing: -0.02em;
  text-wrap: balance;
}

.lead {
  max-width: 760px;
  margin-top: 1rem;
  font-size: 1.08rem;
  line-height: 1.7;
  color: rgb(75, 85, 99);
  font-family: "Raleway", ui-sans-serif, system-ui, sans-serif;
}

.lead-secondary {
  max-width: 760px;
  margin-top: 0.95rem;
  font-size: 1rem;
  line-height: 1.7;
  color: rgb(100, 116, 139);
  font-family: "Raleway", ui-sans-serif, system-ui, sans-serif;
}

  .hero-link {
    display: inline-flex;
    margin-top: 1.25rem;
    color: #2f5bea;
    font-weight: 700;
    text-decoration: none;
    font-family: "Raleway", ui-sans-serif, system-ui, sans-serif;
  }

  .hero-link:hover {
    text-decoration: underline;
  }

  .toolbar-section {
    padding: 0.75rem 0 1.5rem;
    background: transparent;
  }

  .toolbar-intro {
    color: #475569;
    line-height: 1.7;
    margin: 0 0 1.4rem;
    font-size: 1rem;
    font-family: "Raleway", ui-sans-serif, system-ui, sans-serif;
  }

  .toolbar {
    display: grid;
    grid-template-columns: 1.5fr 0.8fr;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .search-wrap,
  .select-wrap {
    position: relative;
  }

  .search-wrap input,
  .select-wrap select {
    width: 100%;
    height: 56px;
    border-radius: 16px;
    border: 1px solid rgba(15, 23, 42, 0.08);
    background: rgba(255,255,255,0.88);
    font-size: 15px;
    padding: 0 16px;
    color: rgb(31, 41, 55);
    outline: none;
    font-family: "Raleway", ui-sans-serif, system-ui, sans-serif;
  }

  .search-wrap input {
    padding-left: 42px;
  }

  .search-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: #7b8496;
    font-size: 16px;
    pointer-events: none;
  }

  .type-tabs {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    padding: 0.6rem;
    border-radius: 16px;
    background: rgba(255,255,255,0.82);
    border: 1px solid rgba(15, 23, 42, 0.06);
  }

  .tab-btn {
    border: none;
    background: transparent;
    padding: 0.8rem 1rem;
    border-radius: 999px;
    font-size: 0.95rem;
    color: #4b5563;
    cursor: pointer;
    font-weight: 700;
    font-family: "Raleway", ui-sans-serif, system-ui, sans-serif;
  }

  .tab-btn.active {
    background: #2f5bea;
    color: #fff;
    box-shadow: 0 10px 20px rgba(47, 91, 234, 0.22);
  }

  .ofertas-grid-section {
    padding: 0.25rem 0 2rem;
    background: transparent;
  }

  .offers-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.6rem;
  }

  .offer-card {
    overflow: hidden;
    border-radius: 32px;
    background: rgba(255,255,255,0.78);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255,255,255,0.5);
    box-shadow: 0 18px 40px rgba(15, 23, 42, 0.08);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .offer-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 22px 48px rgba(15, 23, 42, 0.12);
  }

  .offer-image-wrap {
    position: relative;
    height: 240px;
    overflow: hidden;
    border-bottom: 1px solid rgba(148, 163, 184, 0.18);
  }

  .offer-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 0.5s ease;
  }

  .offer-card:hover .offer-image {
    transform: scale(1.03);
  }

  .offer-image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(15, 23, 42, 0.25), rgba(15, 23, 42, 0.05), transparent);
  }

  .offer-type-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    display: inline-flex;
    border-radius: 999px;
    background: linear-gradient(90deg, #6366f1, #8b5cf6);
    color: #fff;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    padding: 0.65rem 1rem;
    box-shadow: 0 10px 24px rgba(99, 102, 241, 0.25);
    font-family: "Raleway", ui-sans-serif, system-ui, sans-serif;
  }

  .offer-body {
    padding: 1.6rem 1.6rem 1.8rem;
  }

  .offer-institution {
    margin: 0 0 0.55rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: #64748b;
    font-family: "Raleway", ui-sans-serif, system-ui, sans-serif;
  }

  .offer-title {
    margin: 0 0 0.7rem;
    font-size: 2rem;
    line-height: 1.1;
    font-weight: 700;
    color: #0f172a;
    font-family: "Montserrat", sans-serif;
  }

  .offer-modality {
    margin: 0 0 0.8rem;
    font-size: 1rem;
    color: #64748b;
    font-family: "Raleway", ui-sans-serif, system-ui, sans-serif;
  }

  .offer-description {
    margin: 0 0 1.2rem;
    font-size: 1rem;
    line-height: 1.7;
    color: #475569;
    font-family: "Raleway", ui-sans-serif, system-ui, sans-serif;
  }

  .offer-meta-block {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1.3rem;
  }

  .offer-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.42rem 0.8rem;
    border-radius: 999px;
    background: #eef1ff;
    color: #4c5a78;
    font-size: 0.84rem;
    font-weight: 600;
    font-family: "Raleway", ui-sans-serif, system-ui, sans-serif;
  }

  .offer-cta {
    display: inline-flex;
    width: 100%;
    align-items: center;
    justify-content: center;
    border-radius: 20px;
    background: #f1f5f9;
    color: #0f172a;
    font-weight: 700;
    padding: 1rem 1.1rem;
    border: 1px solid #e2e8f0;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
    font-family: "Raleway", ui-sans-serif, system-ui, sans-serif;
  }

  .offer-cta:hover {
    background: #e2e8f0;
    transform: translateY(-1px);
  }

  .cta-section {
    padding: 0 0 5rem;
  }

  .cta-card {
    border-radius: 28px;
    border: 1px solid rgba(255,255,255,0.45);
    background: rgba(255,255,255,0.68);
    backdrop-filter: blur(12px);
    box-shadow: 0 16px 36px rgba(15, 23, 42, 0.07);
    padding: 2rem;
  }

  .cta-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 2rem;
    align-items: center;
  }

  .cta-copy h2 {
    margin: 0 0 1rem;
    font-size: 2rem;
    line-height: 1.1;
    color: #0f172a;
    font-family: "Montserrat", sans-serif;
    font-weight: 700;
  }

  .cta-copy p {
    margin: 0 0 1rem;
    color: #475569;
    line-height: 1.7;
    font-family: "Raleway", ui-sans-serif, system-ui, sans-serif;
  }

  .cta-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .cta-btn-primary,
  .cta-btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 20px;
    padding: 1rem 1.2rem;
    font-weight: 700;
    text-decoration: none;
    font-family: "Raleway", ui-sans-serif, system-ui, sans-serif;
    transition: transform 0.2s ease, opacity 0.2s ease, background 0.2s ease;
  }

  .cta-btn-primary {
    background: #0f172a;
    color: #fff;
  }

  .cta-btn-primary:hover {
    opacity: 0.95;
    transform: translateY(-1px);
  }

  .cta-btn-secondary {
    background: #fff;
    color: #0f172a;
