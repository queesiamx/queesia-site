---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CaseCard from "../../../components/CaseCard.jsx";

export async function getStaticPaths() {
  const res = await fetch("https://queesia.com/api/obtener_categorias.php");
  const data = await res.json();

  if (!data.success || !Array.isArray(data.categories)) {
    throw new Error("La API de categorías no devolvió un arreglo válido.");
  }

  return data.categories.map((category: string) => ({
    params: { category }
  }));
}

interface Props {
  params: {
    category: string;
  };
}

interface Caso {
  id: number;
  app_id: number;
  success_type: string;
  title: string;
  description: string;
  url: string;
  name: string;
  category: string;
  logo_filename: string;
}

const { category } = Astro.params as Props["params"];

if (!category) {
  throw new Error("Categoría no proporcionada en la URL.");
}

const response = await fetch(`https://queesia.com/api/obtener_casos_por_categoria.php?category=${encodeURIComponent(category)}`);
const rawData = await response.json();

const casos: Caso[] = Array.isArray(rawData.cases) ? rawData.cases : [];
---

<BaseLayout>
  <div class="max-w-7xl mx-auto px-4 py-8">
    <h1 class="text-2xl font-bold mb-4 italic">Quesos de éxito: {category} 🧀</h1>

    {casos.filter(
      (caso) =>
        !caso.title?.toLowerCase().includes("no hay quesos de éxito identificados") &&
        caso.description !== "NA" &&
        caso.url !== "NA"
    ).length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 items-stretch">
        {casos
          .filter(
            (caso) =>
              !caso.title?.toLowerCase().includes("no hay quesos de éxito identificados") &&
              caso.description !== "NA" &&
              caso.url !== "NA"
          )
          .map((caso) => (
            <CaseCard caso={caso} />
          ))}
      </div>
    ) : (
      <p class="text-gray-600">No se encontraron quesos de éxito para esta categoría.</p>
    )}
  </div>
</BaseLayout>
