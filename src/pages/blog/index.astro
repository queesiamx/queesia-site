---
import BaseLayout from "../../layouts/BaseLayout.astro";


const TELEGRAM_URL =
  import.meta.env.PUBLIC_TELEGRAM_URL ??
  "https://t.me/radarqueesia";

const DISCORD_URL = import.meta.env.PUBLIC_DISCORD_URL ?? "";
---

<BaseLayout
  title="Blog | Queesia"
  description="Artículos, análisis y aplicaciones de inteligencia artificial en Queesia."
>
  <div
    class="blog-bg-global pointer-events-none fixed inset-0 -z-10"
    aria-hidden="true"
  >
    <div class="blog-bg-mask-y">
      <div class="blog-bg-mask-x">
        <img
          src="/src/assets/bg_amorph.svg"
          class="blog-bg-image"
          alt=""
        />
      </div>
    </div>
  </div>

  <section class="hero-blog">
    <div class="hero-blog-deco" aria-hidden="true">
      <div class="hero-orb hero-orb-left"></div>
      <div class="hero-orb hero-orb-right"></div>
      <div class="hero-half hero-half-left"></div>
      <div class="hero-half hero-half-right"></div>
    </div>

    <div class="container">
      <p class="eyebrow">Blog</p>
      <h1>Ideas, análisis y aplicaciones de inteligencia artificial</h1>
      <p class="lead">
        Exploramos herramientas, casos de uso, tendencias y reflexiones prácticas
        sobre IA para trabajo, negocio, energía, auditoría y transformación digital.
      </p>

      <div class="hero-actions">
        <a href="#blogFeatured" class="btn-primary">Explorar artículos</a>
        <a href="#telegram-community" class="btn-secondary">Unirme al canal</a>
      </div>
    </div>
  </section>

  <section class="stats-section">
    <div class="container">
      <div id="statsGrid" class="stats-grid">
        <article class="stat-card">
          <span class="stat-label">Artículos</span>
          <strong class="stat-value">—</strong>
        </article>
        <article class="stat-card">
          <span class="stat-label">Lecturas totales</span>
          <strong class="stat-value">—</strong>
        </article>
        <article class="stat-card">
          <span class="stat-label">Autores</span>
          <strong class="stat-value">—</strong>
        </article>
        <article class="stat-card">
          <span class="stat-label">Lectura promedio</span>
          <strong class="stat-value">—</strong>
        </article>
      </div>
    </div>
  </section>

  <section class="toolbar-section">
    <div class="container">
      <div class="toolbar">
        <div class="search-wrap">
          <span class="search-icon">⌕</span>
          <input
            id="searchInput"
            type="text"
            placeholder="Buscar artículo, tema, tag o autor..."
          />
        </div>

        <div class="select-wrap">
          <select id="sortSelect">
            <option value="recent">Más recientes</option>
            <option value="popular">Más populares</option>
          </select>
        </div>
      </div>

      <div class="toolbar-meta">
        <div id="resultsMeta" class="results-meta">Cargando artículos...</div>
      </div>
    </div>
  </section>

  <section class="blog-featured-section" id="blogFeatured">
    <div class="container">
      <div id="loadingState" class="loading-state">Cargando blog...</div>
      <div id="featuredContainer"></div>
    </div>
  </section>

  <section class="blog-grid-section">
    <div class="container">
      <div class="section-heading">
        <h2>Artículos recientes</h2>
        <p>
          Contenido curado para explorar herramientas, ideas y aplicaciones reales
          de inteligencia artificial.
        </p>
      </div>

      <div id="postsGrid" class="blog-grid"></div>

      <div id="emptyState" class="empty-state blog-hidden">
        No encontramos artículos con los filtros actuales. Prueba con otra búsqueda.
      </div>

      <div class="load-more-wrap">
        <button id="loadMoreBtn" class="btn-primary btn-load-more blog-hidden">
          Cargar más
        </button>
      </div>
    </div>
  </section>


  <section class="telegram-section" id="telegram-community">
  <div class="container">
    <div class="telegram-card">
      <div class="telegram-copy">
        <p class="eyebrow">Canal</p>
        <h2>Únete al canal</h2>
        <p>
          Recibe señales, tendencias, lanzamientos y casos relevantes sobre IA, energía e innovación.
        </p>
        <p>
          Sigue el Radar Queesia en Telegram y mantente al día. 🧀
        </p>
      </div>

      <div class="telegram-actions">
        {TELEGRAM_URL ? (
          <a
            href={TELEGRAM_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="telegram-btn"
          >
            <svg viewBox="0 0 24 24" class="telegram-btn-icon" fill="currentColor" aria-hidden="true">
              <path d="M21.944 4.506c.315-1.214-.442-1.69-1.45-1.318L2.82 10.01c-1.206.47-1.188 1.143-.206 1.444l4.52 1.41 10.46-6.6c.494-.3.946-.139.575.19l-8.474 7.653-.329 4.635c.482 0 .695-.221.964-.482l2.314-2.248 4.812 3.553c.887.49 1.52.237 1.741-.822l2.747-12.237z"/>
            </svg>
            Telegram
          </a>
        ) : null}

        {DISCORD_URL && (
          <a
            href={DISCORD_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary"
          >
            Discord
          </a>
        )}

        {!TELEGRAM_URL && !DISCORD_URL && (
          <span class="telegram-empty">
            Configura <code>PUBLIC_TELEGRAM_URL</code> o <code>PUBLIC_DISCORD_URL</code> en tu <code>.env</code>.
          </span>
        )}
      </div>
    </div>
  </div>
</section>
            
            
  {/*
<section class="newsletter-section" id="newsletter">
  <div class="container">
    <div class="newsletter-card">
      <div class="newsletter-copy">
        <p class="eyebrow">Newsletter</p>
        <h2>Recibe nuevas publicaciones y señales clave</h2>
        <p>
          Mantente al tanto de artículos, herramientas y análisis sobre IA y su
          aplicación práctica.
        </p>
      </div>

      <form class="newsletter-form">
        <input
          type="email"
          placeholder="Tu correo electrónico"
          aria-label="Correo electrónico"
        />
        <button type="submit" class="btn-primary">Suscribirme</button>
      </form>
    </div>
  </div>
</section>
*/}

  <script is:inline>
    const API_BASE = "https://queesia.com/api/blog";
    const LIST_URL = `${API_BASE}/list.php`;
    const STATS_URL = `${API_BASE}/stats.php`;

    const state = {
      page: 1,
      limit: 7,
      allLoaded: false,
      loading: false,
      query: "",
      sort: "recent",
      items: []
    };

    const loadingState = document.getElementById("loadingState");
    const featuredContainer = document.getElementById("featuredContainer");
    const postsGrid = document.getElementById("postsGrid");
    const emptyState = document.getElementById("emptyState");
    const loadMoreBtn = document.getElementById("loadMoreBtn");
    const searchInput = document.getElementById("searchInput");
    const sortSelect = document.getElementById("sortSelect");
    const resultsMeta = document.getElementById("resultsMeta");
    const statsGrid = document.getElementById("statsGrid");

    function escapeHtml(text) {
      const div = document.createElement("div");
      div.textContent = text ?? "";
      return div.innerHTML;
    }

    function normalizeText(value) {
      return (value || "")
        .toString()
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "");
    }

    function formatDate(value) {
      if (!value) return "";
      try {
        const date = new Date(value);
        return new Intl.DateTimeFormat("es-MX", {
          year: "numeric",
          month: "long",
          day: "numeric"
        }).format(date);
      } catch {
        return value;
      }
    }

    function normalizePost(item = {}) {
      return {
        slug: item.slug || "",
        title: item.title || "Sin título",
        excerpt: item.excerpt || "Sin resumen disponible.",
        coverUrl:
          item.cover_url ||
          item.coverUrl ||
          item.image ||
          `https://picsum.photos/seed/${encodeURIComponent(item.slug || "blog")}/1200/720`,
        readMins: item.read_minutes ?? item.read_time ?? item.readMins ?? 6,
        date: item.published_at || item.date || "",
        tags: Array.isArray(item.tags)
          ? item.tags
          : item.tags
          ? String(item.tags).split(",").map(tag => tag.trim()).filter(Boolean)
          : [],
        authorName:
          item.post_origin === "externo"
            ? (
                item.source_name ||
                (typeof item.author === "string" ? item.author : item.author?.name) ||
                item.author_name ||
                ""
              )
            : (
                (typeof item.author === "string" ? item.author : item.author?.name) ||
                item.author_name ||
                "Equipo Queesia"
              ),
        authorAvatar:
          (typeof item.author === "object" ? item.author?.avatar : "") ||
          item.author_avatar ||
          "",
        views: item.views ?? 0,
        postOrigin: item.post_origin || "queesia",
        postType: item.post_type || "articulo",
        sourceName: item.source_name || "",
        externalUrl: item.external_url || "",
        infographicUrl: item.infographic_url || "",
        multimediaUrl: item.multimedia_url || ""
      };
    }

    function getExternalDestination(post) {
      return post?.externalUrl || post?.multimediaUrl || post?.infographicUrl || "";
    }

    function isExternalPost(post) {
      return post?.postOrigin === "externo" && Boolean(getExternalDestination(post));
    }

    function getPostHref(post) {
      return isExternalPost(post)
        ? getExternalDestination(post)
        : post?.slug
        ? `/blog/post?slug=${encodeURIComponent(post.slug)}`
        : "#";
    }

    function getPostTarget(post) {
      return isExternalPost(post) ? "_blank" : "_self";
    }

    function getPostRel(post) {
      return isExternalPost(post) ? "noopener noreferrer" : "";
    }

    function getPostCtaLabel(post) {
      if (!isExternalPost(post)) return "Leer artículo";

      if (post?.externalUrl) return "Ver fuente original";
      if (post?.multimediaUrl) return "Ver multimedia";
      if (post?.infographicUrl) return "Ver infografía";

      return "Ver recurso";
    }

    function getPostSmallCtaLabel(post) {
      if (!isExternalPost(post)) return "Leer más";

      if (post?.externalUrl) return "Ver fuente";
      if (post?.multimediaUrl) return "Ver multimedia";
      if (post?.infographicUrl) return "Ver infografía";

      return "Ver recurso";
    }

    function getOriginBadgeLabel(post) {
      return post?.postOrigin === "externo"
        ? "Artículo externo"
        : "Artículo Queesia";
    }

    function getResourceBadgeLabel(post) {
      if (post?.externalUrl) return "Fuente externa";
      if (post?.multimediaUrl) return "Multimedia";
      if (post?.infographicUrl) return "Infografía";
      return "Artículo";
    }

    function getSourceLabel(post) {
      return post?.sourceName ? post.sourceName : "";
    }


    function createFeaturedCard(post) {
      if (!post) return "";

      const postUrl = getPostHref(post);
      const postTarget = getPostTarget(post);
      const postRel = getPostRel(post);
      const postCtaLabel = getPostCtaLabel(post);
      const originBadge = getOriginBadgeLabel(post);
      const resourceBadge = getResourceBadgeLabel(post);
      const sourceLabel = getSourceLabel(post);

      return `
        <article class="featured-card">
          <div class="featured-media">
            <img
              src="${escapeHtml(post.coverUrl)}"
              alt="${escapeHtml(post.title)}"
              loading="lazy"
              onerror="this.src='https://picsum.photos/seed/fallback-blog/1200/720';"
            />
          </div>

          <div class="featured-content">
            <div class="featured-meta">
              <span>Destacado</span>
              ${post.date ? `<span>•</span><span>${escapeHtml(formatDate(post.date))}</span>` : ""}
              <span>•</span>
              <span>${escapeHtml(String(post.readMins))} min lectura</span>
            </div>

            <div class="content-badges">
              <span class="content-badge content-badge-origin">${escapeHtml(originBadge)}</span>
              <span class="content-badge content-badge-resource">${escapeHtml(resourceBadge)}</span>
              ${sourceLabel ? `<span class="content-badge content-badge-source">${escapeHtml(sourceLabel)}</span>` : ""}
            </div>

            <h2>${escapeHtml(post.title)}</h2>
            <p class="featured-summary">${escapeHtml(post.excerpt)}</p>

            ${
              post.tags.length
                ? `
                  <div class="tags">
                    ${post.tags.map(tag => `<span class="tag">${escapeHtml(tag)}</span>`).join("")}
                  </div>
                `
                : ""
            }

                        ${
                          post.authorName
                            ? `
                              <div class="author-row">
                                ${
                                  post.authorAvatar
                                    ? `<img src="${escapeHtml(post.authorAvatar)}" alt="${escapeHtml(post.authorName)}" onerror="this.style.display='none';" />`
                                    : ""
                                }
                                <span>${escapeHtml(post.authorName)}</span>
                              </div>
                            `
                            : ""
                        }

           <div class="actions">
              <a
                href="${escapeHtml(postUrl)}"
                target="${postTarget}"
                rel="${postRel}"
                class="btn-primary"
              >
                ${postCtaLabel}
              </a>
            </div>
          </div>
        </article>
      `;
    }

    function createPostCard(post) {
      const postUrl = getPostHref(post);
      const postTarget = getPostTarget(post);
      const postRel = getPostRel(post);
      const postCtaLabel = getPostSmallCtaLabel(post);
      const originBadge = getOriginBadgeLabel(post);
      const resourceBadge = getResourceBadgeLabel(post);

      return `
        <article class="post-card">
          <div class="post-card-image">
            <img
              src="${escapeHtml(post.coverUrl)}"
              alt="${escapeHtml(post.title)}"
              loading="lazy"
              onerror="this.src='https://picsum.photos/seed/fallback-card/800/520';"
            />
          </div>

          <div class="post-card-body">
            <div class="post-meta">
              ${post.date ? `<span>${escapeHtml(formatDate(post.date))}</span>` : ""}
              ${post.date ? `<span>•</span>` : ""}
              <span>${escapeHtml(String(post.readMins))} min</span>
            </div>

            <div class="content-badges content-badges-small">
              <span class="content-badge content-badge-origin">${escapeHtml(originBadge)}</span>
              <span class="content-badge content-badge-resource">${escapeHtml(resourceBadge)}</span>
            </div>

            <h3>${escapeHtml(post.title)}</h3>
            <p class="post-excerpt">${escapeHtml(post.excerpt)}</p>

            ${
              post.tags.length
                ? `
                  <div class="tags">
                    ${post.tags.slice(0, 3).map(tag => `<span class="tag">${escapeHtml(tag)}</span>`).join("")}
                  </div>
                `
                : ""
            }

            <div class="post-footer">
              ${
                post.authorName
                  ? `<span class="post-author">${escapeHtml(post.authorName)}</span>`
                  : `<span></span>`
              }
              <a
                href="${escapeHtml(postUrl)}"
                target="${postTarget}"
                rel="${postRel}"
                class="text-link"
              >
                ${postCtaLabel}
              </a>
            </div>
          </div>
        </article>
      `;
    }

    function updateResultsMeta(total) {
      if (!resultsMeta) return;
      resultsMeta.textContent = total === 1
        ? "1 artículo encontrado"
        : `${total} artículos encontrados`;
    }

    function renderStats(stats = {}) {
      const totalPosts = stats.total_posts ?? stats.posts ?? "—";
      const totalViews = stats.total_views ?? stats.views ?? "—";
      const totalAuthors = stats.total_authors ?? stats.authors ?? "—";
      const avgRead = stats.avg_read_time ?? stats.average_read_time ?? "—";

      statsGrid.innerHTML = `
        <article class="stat-card">
          <span class="stat-label">Artículos</span>
          <strong class="stat-value">${escapeHtml(String(totalPosts))}</strong>
        </article>
        <article class="stat-card">
          <span class="stat-label">Lecturas totales</span>
          <strong class="stat-value">${escapeHtml(String(totalViews))}</strong>
        </article>
        <article class="stat-card">
          <span class="stat-label">Autores</span>
          <strong class="stat-value">${escapeHtml(String(totalAuthors))}</strong>
        </article>
        <article class="stat-card">
          <span class="stat-label">Lectura promedio</span>
          <strong class="stat-value">${escapeHtml(String(avgRead))}</strong>
        </article>
      `;
    }

    function renderPosts() {
      const items = state.items.slice();
      updateResultsMeta(items.length);

      const featured = items[0] || null;
      const rest = items.slice(1);

      if (featured) {
        featuredContainer.innerHTML = createFeaturedCard(featured);
      } else {
        featuredContainer.innerHTML = "";
      }

      const sectionHeadingTitle = document.querySelector(".section-heading h2");
      const sectionHeadingText = document.querySelector(".section-heading p");

      if (rest.length) {
        if (sectionHeadingTitle) sectionHeadingTitle.textContent = "Artículos recientes";
        if (sectionHeadingText) {
          sectionHeadingText.textContent = "Contenido curado para explorar herramientas, ideas y aplicaciones reales de inteligencia artificial.";
        }

        postsGrid.innerHTML = rest.map(createPostCard).join("");
        postsGrid.classList.remove("blog-hidden");
        emptyState.classList.add("blog-hidden");
      } else if (!featured) {
        if (sectionHeadingTitle) sectionHeadingTitle.textContent = "Artículos recientes";
        if (sectionHeadingText) {
          sectionHeadingText.textContent = "Contenido curado para explorar herramientas, ideas y aplicaciones reales de inteligencia artificial.";
        }

        postsGrid.innerHTML = "";
        postsGrid.classList.add("blog-hidden");
        emptyState.classList.remove("blog-hidden");
      } else {
        if (sectionHeadingTitle) sectionHeadingTitle.textContent = "Próximamente más artículos";
        if (sectionHeadingText) {
          sectionHeadingText.textContent = "Ya tenemos una publicación disponible. Conforme se integren nuevos artículos, aparecerán aquí.";
        }

        postsGrid.innerHTML = "";
        postsGrid.classList.add("blog-hidden");
        emptyState.classList.add("blog-hidden");
      }

      if (state.allLoaded || items.length < state.limit) {
        loadMoreBtn.classList.add("blog-hidden");
      } else {
        loadMoreBtn.classList.remove("blog-hidden");
      }
    }

    async function fetchStats() {
      try {
        const response = await fetch(STATS_URL, { cache: "no-store" });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const data = await response.json();
        renderStats(data);
      } catch (error) {
        console.warn("No fue posible cargar stats del blog:", error);
      }
    }

    async function fetchPosts({ reset = false } = {}) {
      if (state.loading) return;
      state.loading = true;

      try {
        const params = new URLSearchParams({
          page: String(state.page),
          limit: String(state.limit),
          sort: state.sort
        });

        if (state.query) {
          params.set("query", state.query);
        }

        const response = await fetch(`${LIST_URL}?${params.toString()}`, {
          cache: "no-store"
        });

        if (!response.ok) throw new Error(`HTTP ${response.status}`);

        const payload = await response.json();
        const rawItems = payload.items ?? payload.data ?? [];
        const normalized = Array.isArray(rawItems) ? rawItems.map(normalizePost) : [];

        if (reset) {
          state.items = normalized;
        } else {
          state.items = state.items.concat(normalized);
        }

        state.allLoaded = normalized.length < state.limit;
        renderPosts();
      } catch (error) {
        console.error("Error al cargar artículos:", error);

        if (!state.items.length) {
          featuredContainer.innerHTML = "";
          postsGrid.classList.add("blog-hidden");
          emptyState.classList.remove("blog-hidden");
          emptyState.textContent = "No fue posible cargar el blog en este momento.";
        }
      } finally {
        state.loading = false;
        loadingState.classList.add("blog-hidden");
      }
    }

    async function resetAndReload() {
      state.page = 1;
      state.allLoaded = false;
      state.items = [];
      loadingState.classList.remove("blog-hidden");
      await fetchPosts({ reset: true });
    }

    function debounce(fn, delay = 350) {
      let timer;
      return (...args) => {
        clearTimeout(timer);
        timer = setTimeout(() => fn(...args), delay);
      };
    }

    searchInput?.addEventListener("input", debounce(async (e) => {
      state.query = e.target.value || "";
      await resetAndReload();
    }, 350));

    sortSelect?.addEventListener("change", async (e) => {
      state.sort = e.target.value || "recent";
      await resetAndReload();
    });

    loadMoreBtn?.addEventListener("click", async () => {
      if (state.allLoaded || state.loading) return;
      state.page += 1;
      await fetchPosts({ reset: false });
    });

    fetchStats();
    fetchPosts({ reset: true });
  </script>
</BaseLayout>

<style is:global>
  .telegram-section {
  padding: 0 0 3.2rem;
  background: transparent;
}

.telegram-card {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  gap: 1.4rem;
  align-items: center;
  background: rgba(255,255,255,0.84);
  backdrop-filter: blur(10px);
  border: 1px solid #d9dff8;
  border-radius: 24px;
  padding: 1.75rem 1.8rem;
  box-shadow: 0 10px 30px rgba(15, 23, 42, 0.05);
}

.telegram-copy h2 {
  margin: 0 0 0.45rem;
  font-size: 1.8rem;
  color: #111827;
  font-family: "Montserrat", sans-serif;
  font-style: normal;
  font-weight: 500;
  letter-spacing: -0.02em;
}

.telegram-copy p {
  margin: 0 0 0.7rem;
  color: #6b7280;
  line-height: 1.65;
  font-family: "Raleway", ui-sans-serif, system-ui, sans-serif;
}

.telegram-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  align-items: center;
  gap: 0.85rem;
}

.telegram-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.55rem;
  padding: 0.88rem 1.2rem;
  border-radius: 999px;
  text-decoration: none;
  font-weight: 700;
  color: #ffffff;
  background: #2aabee;
  transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  font-family: "Raleway", ui-sans-serif, system-ui, sans-serif;
}

.telegram-btn:hover {
  transform: translateY(-1px);
  box-shadow: 0 8px 20px rgba(42, 171, 238, 0.22);
  background: #1d9fe3;
}

.telegram-btn-icon {
  width: 18px;
  height: 18px;
}

.telegram-empty {
  color: #64748b;
  font-size: 0.9rem;
  font-family: "Raleway", ui-sans-serif, system-ui, sans-serif;
}

  .blog-bg-global {
    background: transparent;
  }

  .blog-bg-mask-y {
    width: 100%;
    height: 100%;
    mask-image: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0),
      #000 12%,
      #000 88%,
      rgba(0, 0, 0, 0)
    );
    -webkit-mask-image: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0),
      #000 12%,
      #000 88%,
      rgba(0, 0, 0, 0)
    );
    mask-repeat: no-repeat;
    -webkit-mask-repeat: no-repeat;
  }

  .blog-bg-mask-x {
    width: 100%;
    height: 100%;
    mask-image: linear-gradient(
      to right,
      rgba(0, 0, 0, 0),
      #000 10%,
      #000 90%,
