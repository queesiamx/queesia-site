---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Artículo | Queesia"
  description="Artículo del blog de Queesia."
>
  <div
    class="blog-post-bg-global pointer-events-none fixed inset-0 -z-10"
    aria-hidden="true"
  >
    <div class="blog-post-bg-mask-y">
      <div class="blog-post-bg-mask-x">
        <img
          src="/src/assets/bg_amorph.svg"
          class="blog-post-bg-image"
          alt=""
        />
      </div>
    </div>
  </div>

  <section class="blog-post-hero">
    <div class="hero-blog-deco" aria-hidden="true">
      <div class="hero-orb hero-orb-left"></div>
      <div class="hero-orb hero-orb-right"></div>
      <div class="hero-half hero-half-left"></div>
      <div class="hero-half hero-half-right"></div>
    </div>

    <div class="container">
      <a href="/blog" class="back-link">← Volver al blog</a>
      <div id="postHero"></div>
    </div>
  </section>

  <section class="blog-post-body-section">
    <div class="container">
      <div id="loadingState" class="loading-state">Cargando artículo...</div>

      <div id="errorState" class="empty-state blog-hidden">
        No fue posible cargar este artículo.
      </div>

      <div id="postBodyWrap" class="blog-hidden">
        <div class="blog-post-layout">
          <article class="blog-post-content-card">
            <div id="postCover"></div>
            <div id="postContent" class="blog-post-content"></div>
          </article>

          <aside class="blog-post-sidebar">
            <div class="sidebar-card" id="postMetaCard"></div>
            <div class="sidebar-card blog-hidden" id="postColabCard"></div>
          </aside>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    const API_BASE = "https://queesia.com/api/blog";
    const POST_URL = `${API_BASE}/post.php`;

    const loadingState = document.getElementById("loadingState");
    const errorState = document.getElementById("errorState");
    const postBodyWrap = document.getElementById("postBodyWrap");
    const postHero = document.getElementById("postHero");
    const postCover = document.getElementById("postCover");
    const postContent = document.getElementById("postContent");
    const postMetaCard = document.getElementById("postMetaCard");
    const postColabCard = document.getElementById("postColabCard");

    function escapeHtml(text) {
      const div = document.createElement("div");
      div.textContent = text ?? "";
      return div.innerHTML;
    }

    function formatDate(value) {
      if (!value) return "";
      try {
        const date = new Date(value);
        return new Intl.DateTimeFormat("es-MX", {
          year: "numeric",
          month: "long",
          day: "numeric"
        }).format(date);
      } catch {
        return value;
      }
    }

    function getSlugFromUrl() {
      const params = new URLSearchParams(window.location.search);
      return params.get("slug") || "";
    }

    function normalizePost(payload = {}) {
      const post = payload.post || payload || {};

      return {
        slug: post.slug || "",
        title: post.title || "Sin título",
        excerpt: post.excerpt || "Sin resumen disponible.",
        coverUrl:
          post.cover_url ||
          post.coverUrl ||
          post.image ||
          "",
        tags: Array.isArray(post.tags)
          ? post.tags
          : post.tags
          ? String(post.tags).split(",").map(tag => tag.trim()).filter(Boolean)
          : [],
        authorName: post.author_name || post.author || "Equipo Queesia",
        authorAvatar: post.author_avatar || "",
        readMins: post.read_time ?? post.read_minutes ?? 6,
        publishedAt: post.published_at || post.date || "",
        views: post.views ?? 0,
        contentHtml: post.content_html || "",
        contentMd: post.content_md || "",
        colabUrl: post.colab_url || ""
      };
    }

    function renderHero(post) {
      postHero.innerHTML = `
        <div class="post-hero-meta">
          <span>Blog</span>
          ${post.publishedAt ? `<span>•</span><span>${escapeHtml(formatDate(post.publishedAt))}</span>` : ""}
          <span>•</span>
          <span>${escapeHtml(String(post.readMins))} min lectura</span>
        </div>

        <h1>${escapeHtml(post.title)}</h1>

        <p class="post-hero-excerpt">${escapeHtml(post.excerpt)}</p>

        ${
          post.tags.length
            ? `
              <div class="tags">
                ${post.tags.map(tag => `<span class="tag">${escapeHtml(tag)}</span>`).join("")}
              </div>
            `
            : ""
        }
      `;
    }

    function renderCover(post) {
      if (!post.coverUrl) {
        postCover.innerHTML = "";
        return;
      }

      postCover.innerHTML = `
        <div class="post-cover-wrap">
          <img
            src="${escapeHtml(post.coverUrl)}"
            alt="${escapeHtml(post.title)}"
            loading="eager"
            onerror="this.parentElement.style.display='none';"
          />
        </div>
      `;
    }

    function renderMeta(post) {
      postMetaCard.innerHTML = `
        <p class="sidebar-eyebrow">Artículo</p>

        <div class="author-row">
          ${
            post.authorAvatar
              ? `<img src="${escapeHtml(post.authorAvatar)}" alt="${escapeHtml(post.authorName)}" onerror="this.style.display='none';" />`
              : ""
          }
          <div>
            <strong>${escapeHtml(post.authorName)}</strong>
            <span>${post.publishedAt ? escapeHtml(formatDate(post.publishedAt)) : "Fecha no disponible"}</span>
          </div>
        </div>

        <div class="meta-list">
          <div class="meta-item">
            <span>Tiempo de lectura</span>
            <strong>${escapeHtml(String(post.readMins))} min</strong>
          </div>
          <div class="meta-item">
            <span>Lecturas</span>
            <strong>${escapeHtml(String(post.views))}</strong>
          </div>
        </div>
      `;
    }

    function renderColab(post) {
      if (!post.colabUrl) {
        postColabCard.classList.add("blog-hidden");
        return;
      }

      postColabCard.classList.remove("blog-hidden");
      postColabCard.innerHTML = `
        <p class="sidebar-eyebrow">Recurso adicional</p>
        <h3>Notebook o enlace relacionado</h3>
        <p>Consulta el recurso complementario asociado a este artículo.</p>
        <a
          href="${escapeHtml(post.colabUrl)}"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary"
        >
          Abrir recurso
        </a>
      `;
    }

    function renderContent(post) {
      if (post.contentHtml && post.contentHtml.trim() !== "") {
        postContent.innerHTML = post.contentHtml;
        return;
      }

      if (post.contentMd && post.contentMd.trim() !== "") {
        postContent.innerHTML = `<pre class="markdown-fallback">${escapeHtml(post.contentMd)}</pre>`;
        return;
      }

      postContent.innerHTML = `<p>No hay contenido disponible para este artículo.</p>`;
    }

    async function loadPost() {
      const slug = getSlugFromUrl();

      if (!slug) {
        loadingState.classList.add("blog-hidden");
        errorState.classList.remove("blog-hidden");
        errorState.textContent = "No se indicó ningún artículo para cargar.";
        return;
      }

      try {
        const response = await fetch(`${POST_URL}?slug=${encodeURIComponent(slug)}`, {
          cache: "no-store"
        });

        if (!response.ok) {
          throw new Error(`HTTP ${response.status}`);
        }

        const payload = await response.json();
        const post = normalizePost(payload);

        document.title = `${post.title} | Queesia`;

        renderHero(post);
        renderCover(post);
        renderMeta(post);
        renderColab(post);
        renderContent(post);

        postBodyWrap.classList.remove("blog-hidden");
        errorState.classList.add("blog-hidden");
      } catch (error) {
        console.error("Error al cargar artículo:", error);
        errorState.classList.remove("blog-hidden");
        errorState.textContent = "No fue posible cargar este artículo en este momento.";
      } finally {
        loadingState.classList.add("blog-hidden");
      }
    }

    loadPost();
  </script>
</BaseLayout>

<style is:global>
  .blog-post-bg-global {
    background: transparent;
  }

  .blog-post-bg-mask-y {
    width: 100%;
    height: 100%;
    mask-image: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0),
      #000 12%,
      #000 88%,
      rgba(0, 0, 0, 0)
    );
    -webkit-mask-image: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0),
      #000 12%,
      #000 88%,
      rgba(0, 0, 0, 0)
    );
    mask-repeat: no-repeat;
    -webkit-mask-repeat: no-repeat;
  }

  .blog-post-bg-mask-x {
    width: 100%;
    height: 100%;
    mask-image: linear-gradient(
      to right,
      rgba(0, 0, 0, 0),
      #000 10%,
      #000 90%,
      rgba(0, 0, 0, 0)
    );
    -webkit-mask-image: linear-gradient(
      to right,
      rgba(0, 0, 0, 0),
      #000 10%,
      #000 90%,
      rgba(0, 0, 0, 0)
    );
    mask-repeat: no-repeat;
    -webkit-mask-repeat: no-repeat;
  }

  .blog-post-bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.22;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  .blog-post-hero {
  position: relative;
  overflow: hidden;
  padding: 5.35rem 0 2.35rem;
  background: transparent;
}

  .hero-blog-deco {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .hero-orb {
    position: absolute;
    border-radius: 999px;
    background: transparent;
    backdrop-filter: blur(2px);
    mix-blend-mode: soft-light;
    border: 1px solid rgba(255,255,255,0.3);
  }

  .hero-orb-left {
    top: -36px;
    left: -64px;
    width: 280px;
    height: 280px;
  }

  .hero-orb-right {
    bottom: -48px;
    right: -70px;
    width: 260px;
    height: 260px;
  }

  .hero-half {
    position: absolute;
    border: 1px solid rgba(255,255,255,0.28);
    background: transparent;
    mix-blend-mode: soft-light;
  }

  .hero-half-left {
    top: 72px;
    left: -88px;
    width: 230px;
    height: 230px;
    border-radius: 999px 0 0 999px;
  }

  .hero-half-right {
    bottom: 30px;
    right: -88px;
    width: 230px;
    height: 230px;
    border-radius: 999px 0 0 999px;
  }

  .blog-post-hero > .container {
    position: relative;
    z-index: 1;
  }

  .back-link {
    display: inline-flex;
    margin-bottom: 1rem;
    color: #5b6ee1;
    text-decoration: none;
    font-weight: 700;
    font-family: "Raleway", ui-sans-serif, system-ui, sans-serif;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  .post-hero-meta {
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
  font-size: 0.88rem;
  color: #64748b;
  font-weight: 700;
  font-family: "Raleway", ui-sans-serif, system-ui, sans-serif;
}

  #postHero h1 {
  margin: 0.9rem 0 0.7rem;
  font-size: clamp(2rem, 4vw, 3.3rem);
  line-height: 1.1;
  color: rgb(31, 41, 55);
  max-width: 900px;
  font-family: "Montserrat", sans-serif;
  font-style: normal;
  font-weight: 500;
  letter-spacing: -0.02em;
  text-wrap: balance;
}

  .post-hero-excerpt {
  max-width: 820px;
  margin: 0;
  font-size: 1.04rem;
  line-height: 1.72;
  color: rgb(75, 85, 99);
  font-family: "Raleway", ui-sans-serif, system-ui, sans-serif;
}

  .blog-post-body-section {
    padding: 0.25rem 0 4rem;
    background: transparent;
  }

  .blog-post-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 330px;
  gap: 1.5rem;
  align-items: start;
}

  .blog-post-content-card,
  .sidebar-card {
    background: rgba(255,255,255,0.86);
    backdrop-filter: blur(10px);
    border: 1px solid #d9dff8;
    border-radius: 24px;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.05);
  }

  .blog-post-content-card {
    overflow: hidden;
  }

  .post-cover-wrap img {
  width: 100%;
  max-height: 460px;
  object-fit: cover;
  display: block;
}

.post-cover-wrap {
  border-bottom: 1px solid rgba(217, 223, 248, 0.72);
}

  .blog-post-content {
  padding: 1.85rem 1.75rem 1.95rem;
  color: #374151;
  font-family: "Raleway", ui-sans-serif, system-ui, sans-serif;
  line-height: 1.82;
  font-size: 1.03rem;
}

  .blog-post-content h1,
.blog-post-content h2,
.blog-post-content h3,
.blog-post-content h4 {
  color: #111827;
  font-family: "Montserrat", sans-serif;
  line-height: 1.22;
  margin-top: 1.6em;
  margin-bottom: 0.65em;
  font-weight: 500;
  letter-spacing: -0.015em;
}

  .blog-post-content h1 { font-size: 1.95rem; }
.blog-post-content h2 { font-size: 1.62rem; }
.blog-post-content h3 { font-size: 1.32rem; }
.blog-post-content h4 { font-size: 1.08rem; }

  .blog-post-content p,
.blog-post-content ul,
.blog-post-content ol,
.blog-post-content blockquote,
.blog-post-content pre {
  margin: 0 0 1.18rem;
}

 .blog-post-content ul,
.blog-post-content ol {
  padding-left: 1.35rem;
}

  .blog-post-content img {
    max-width: 100%;
    border-radius: 16px;
    display: block;
    margin: 1rem 0;
  }

  .blog-post-content a {
    color: #2f5bea;
  }

  .blog-post-content blockquote {
    border-left: 4px solid #cfd8ff;
    padding-left: 1rem;
    color: #475569;
  }

  .blog-post-content pre {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 1rem;
    overflow: auto;
  }

  .markdown-fallback {
    white-space: pre-wrap;
    word-break: break-word;
  }

  .blog-post-sidebar {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  position: sticky;
  top: 104px;
}

  .sidebar-card {
  padding: 1.3rem;
}

  .sidebar-eyebrow {
    margin: 0 0 0.7rem;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #5b6ee1;
    font-family: "Raleway", ui-sans-serif, system-ui, sans-serif;
  }

  .sidebar-card h3 {
  margin: 0 0 0.55rem;
  color: #111827;
  font-family: "Montserrat", sans-serif;
  font-size: 1.08rem;
  line-height: 1.28;
  font-weight: 500;
}

#postColabCard {
  background: linear-gradient(
    180deg,
    rgba(255,255,255,0.9) 0%,
    rgba(245,247,255,0.92) 100%
  );
}

  .sidebar-card p {
    margin: 0 0 1rem;
    color: #6b7280;
    line-height: 1.65;
    font-family: "Raleway", ui-sans-serif, system-ui, sans-serif;
  }

  .author-row {
  display: flex;
  gap: 0.8rem;
  align-items: center;
  margin-bottom: 1.05rem;
}

  .author-row img {
    width: 44px;
    height: 44px;
    border-radius: 999px;
    object-fit: cover;
  }

  .author-row strong,
.meta-item strong {
  display: block;
  color: #111827;
  font-family: "Montserrat", sans-serif;
  font-weight: 500;
}

  .author-row span,
  .meta-item span {
    color: #64748b;
    font-family: "Raleway", ui-sans-serif, system-ui, sans-serif;
    font-size: 0.94rem;
  }

  .meta-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .meta-item + .meta-item {
  border-top: 1px solid rgba(217, 223, 248, 0.7);
  padding-top: 0.85rem;
}

  .meta-item {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  align-items: baseline;
  padding-top: 0.15rem;
}

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1.1rem 0 0;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    padding: 0.42rem 0.8rem;
    border-radius: 999px;
    background: #eef1ff;
    color: #4c5a78;
    font-size: 0.84rem;
    font-weight: 600;
    font-family: "Raleway", ui-sans-serif, system-ui, sans-serif;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.2rem;
    border-radius: 999px;
    font-weight: 700;
    text-decoration: none;
    border: none;
    cursor: pointer;
    background: #2f5bea;
    color: #ffffff;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    font-family: "Raleway", ui-sans-serif, system-ui, sans-serif;
  }

  .btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 20px rgba(47, 91, 234, 0.20);
  }

  .loading-state,
  .empty-state {
    background: #ffffff;
    border: 1px solid #d9dff8;
    border-radius: 20px;
    padding: 1.5rem;
    color: rgb(75, 85, 99);
    line-height: 1.7;
    font-family: "Raleway", ui-sans-serif, system-ui, sans-serif;
  }

  .blog-hidden {
    display: none !important;
  }

  @media (max-width: 1000px) {
    .telegram-card {
    grid-template-columns: 1fr;
    }

    .telegram-actions {
    justify-content: flex-start;
    }
    .blog-post-layout {
      grid-template-columns: 1fr;
    }

    .blog-post-sidebar {
      position: static;
    }
  }

  @media (max-width: 900px) {
    .blog-post-hero {
      padding: 6.25rem 0 1.6rem;
    }

    .blog-post-content {
  padding: 1.35rem 1.2rem 1.5rem;
}
  }

  @media (max-width: 640px) {
    .telegram-btn {
    width: 100%;
    }
    #postHero h1 {
      font-size: 2.1rem;
      line-height: 1.08;
    }

    .post-hero-excerpt {
      font-size: 1rem;
      line-height: 1.7;
    }
    .post-hero-meta {
  font-size: 0.84rem;
}

.tags {
  gap: 0.5rem;
}

.tag {
  font-size: 0.8rem;
  padding: 0.38rem 0.72rem;
}
  }
</style>