      } catch (error) {
        console.error("✖ Error en la búsqueda:", error);
        resultadoDiv.innerHTML = "";
        mensajeNoResultados.classList.remove("hidden");
      }
    }

    function mostrarResultados(apps) {
      if (!resultadoDiv || !mensajeNoResultados) return;
      resultadoDiv.innerHTML = "";
      if (!apps || apps.length === 0) {
        mensajeNoResultados.classList.remove("hidden");
        return;
      }
      mensajeNoResultados.classList.add("hidden");

      apps.forEach(app => {
        const defaultLogoURL = "https://queesia.com/logos/default-logo.png";
        const rawLogoFilename = app.logo_filename
          ? String(app.logo_filename).split("/").pop().trim()
          : "";
        const hasLogoExtension = /\.(png|jpg|jpeg|webp|svg)$/i.test(rawLogoFilename);
        const logoURL = rawLogoFilename
          ? `https://queesia.com/logos/${
              hasLogoExtension ? rawLogoFilename : `${rawLogoFilename}.png`
           }`
          : defaultLogoURL;

        const rate = app.rate && parseFloat(app.rate) > 0
          ? `<p class="text-sm mb-2 text-yellow-600 font-medium">★ ${app.rate} / 5</p>`
          : `<p class="text-sm mb-2 text-gray-400 font-medium">★ N/A</p>`;

        const tags = Array.isArray(app.tags) && app.tags.length > 0
          ? app.tags.map(tag => `<span class="bg-primary text-white text-xs px-2 py-1 rounded animate-fade-in">${tag}</span>`).join(" ")
          : `<span class="bg-gray-400 text-white text-xs px-2 py-1 rounded">Sin etiquetas</span>`;

        resultadoDiv.innerHTML += `
          <div class="relative bg-white border border-gray-200 rounded-xl shadow hover:shadow-lg transition duration-200 flex flex-col items-center text-center p-4 w-full max-w-xs mx-auto">
            <div class="w-24 h-24 bg-white rounded-xl shadow flex items-center justify-center overflow-hidden mb-4">
              <img
                src="${logoURL}"
                alt="Logo de ${app.name}"
                class="max-w-[80%] max-h-[80%] object-contain"
                loading="lazy"
                onerror="this.onerror=null;this.src='https://queesia.com/logos/default-logo.png';"
              />
            </div>
            <h2 class="text-lg font-semibold text-default mb-1">${app.name}</h2>
            <p class="text-sm text-default-soft italic mb-1">${app.category ?? "Categoría no disponible"}</p>
            ${rate}
            <div class="flex flex-wrap justify-center gap-2 my-2">${tags}</div>
            <p class="text-sm text-default mt-3 min-h-[70px]">${app.short_description ?? "Descripción no disponible"}</p>
            <div class="pt-4 w-full flex justify-center mt-auto">
              <a href="/app/${app.id}" class="bg-black text-white hover:bg-default-soft hover:scale-105 px-4 py-2 rounded-md text-sm font-medium transition-all duration-300">
                Derrite tu curiosidad
              </a>
            </div>
          </div>
        `;
      });
    }

    if (searchInput && searchBtn) {
      searchInput.addEventListener("input", (e) => buscarAplicaciones(e.target.value));
      searchBtn.addEventListener("click", () => buscarAplicaciones(searchInput.value));
    }
  });
</script>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const sticky = document.getElementById("catalogoSticky");
    const btnTop = document.getElementById("catalogoGoTop");
    const btnBottom = document.getElementById("catalogoGoBottom");

    const getCategories = () =>
      Array.from(document.querySelectorAll('[id^="cat-"]'));

    function getOffset() {
      const isMobile = window.innerWidth < 768;
      const stickyHeight = sticky ? sticky.offsetHeight : 0;

      // En móvil compensamos navbar + bloque sticky + aire visual.
      return isMobile ? stickyHeight + 48 : 96;
    }

    function applyScrollMargins() {
      const offset = getOffset();

      getCategories().forEach((el) => {
        el.style.scrollMarginTop = `${offset}px`;
      });

      const start = document.getElementById("catalogoContentStart");
      const end = document.getElementById("catalogoContentEnd");

      if (start) start.style.scrollMarginTop = `${offset}px`;
      if (end) end.style.scrollMarginTop = `${offset}px`;
    }

    function scrollToElement(el, behavior = "smooth") {
      if (!el) return;

      const top = el.getBoundingClientRect().top + window.scrollY - getOffset();

      window.scrollTo({
        top: Math.max(top, 0),
        behavior,
      });
    }

    function scrollToCurrentHash(behavior = "smooth") {
      if (!window.location.hash) return;

      const id = decodeURIComponent(window.location.hash.replace("#", ""));
      const target = document.getElementById(id);

      if (target) {
        scrollToElement(target, behavior);
      }
    }

    // Aplica margen inicial.
    applyScrollMargins();

    // React puede renderizar las categorías después del DOMContentLoaded.
    // Por eso observamos cambios y recalculamos.
    const observer = new MutationObserver(() => {
      applyScrollMargins();

      if (window.location.hash.startsWith("#cat-")) {
        scrollToCurrentHash("auto");
      }
    });

    observer.observe(document.body, {
      childList: true,
      subtree: true,
    });

    window.addEventListener("resize", () => {
      applyScrollMargins();
      scrollToCurrentHash("auto");
    });

    window.addEventListener("hashchange", () => {
      setTimeout(() => {
        applyScrollMargins();
        scrollToCurrentHash("smooth");
      }, 80);
    });

    // Intercepta clics en chips/anclas de categoría para evitar que el sticky tape la card.
    document.addEventListener("click", (event) => {
      const link = event.target.closest('a[href^="#cat-"]');
      if (!link) return;

      const href = link.getAttribute("href");
      const target = document.querySelector(href);

      if (!target) return;

      event.preventDefault();

      history.pushState(null, "", href);
      applyScrollMargins();
      scrollToElement(target, "smooth");
    });

    btnTop?.addEventListener("click", () => {
      const categories = getCategories();
      const firstCategory =
        categories[0] || document.getElementById("catalogoContentStart");

      scrollToElement(firstCategory);
    });

    btnBottom?.addEventListener("click", () => {
      const categories = getCategories();
      const lastCategory =
        categories[categories.length - 1] ||
        document.getElementById("catalogoContentEnd");

      scrollToElement(lastCategory);
    });

    // Si cargas directo con URL tipo /#cat-bienestar.
    setTimeout(() => {
      applyScrollMargins();
      scrollToCurrentHash("auto");
    }, 300);
  });
</script>

