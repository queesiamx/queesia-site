// src/pages/index.astro
import Layout from "../layouts/BaseLayout.astro";
import ToolCard from "../components/ToolCard.astro";
import MiniToolCard from "../components/MiniToolCard.tsx";
import CategoryPreview from "../components/CategoryPreview.tsx";
import VisitCounter from "../components/VisitCounter.jsx";
import HomeNewAppsDynamic from "../components/HomeNewAppsDynamic.jsx";
import HomeCategoryChipsDynamic from "../components/HomeCategoryChipsDynamic.jsx";
import HomeCategoryGridDynamic from "../components/HomeCategoryGridDynamic.jsx";
import type { App } from "../types";
//import SectionDeco from "~/components/SectionDeco.astro";
import SectionCircuits from "~/components/SectionCircuits.astro";
import BgAmorph from "~/components/BgAmorph.astro";
import MobileSocialDock from "../components/social/MobileSocialDock.jsx"
import DesktopSocialDock from "../components/social/DesktopSocialRail.jsx";
import QueesiaBotWidget from "../components/QueesiaBotWidget.jsx";
import RepositorioNacionalAd from "../components/RepositorioNacionalAd.jsx";
import AdBanner from "../components/AdBanner.jsx";
import AdPopup from "../components/AdPopup.jsx";


const TELEGRAM_URL =
  import.meta.env.PUBLIC_TELEGRAM_URL ??
  "https://t.me/radarqueesia";

const DISCORD_URL = import.meta.env.PUBLIC_DISCORD_URL ?? "";

// 1) Categorías
const resCategories = await fetch("https://queesia.com/api/obtener_categorias.php");
let categorias: string[] = [];
if (resCategories.ok) {
  try {
    const dataCategories = await resCategories.json();
    if (dataCategories?.success && Array.isArray(dataCategories.categories)) {
      categorias = dataCategories.categories
        .filter((c: unknown) => typeof c === "string" && c.trim() !== "")
        .map((c: string) => c.trim());
    }
  } catch {}
}

// Métrica total de apps (preferir `total`; si no, length)
let totalApps = 0;
try {
  const resAll = await fetch(
    "https://queesia.com/api/obtener_datos.php?all=1&limit=5000&page=1&_nocache=" + Date.now()
  );
  if (resAll.ok) {
    const dataAll = await resAll.json();
    if (typeof dataAll.total === "number") totalApps = dataAll.total;
    else if (Array.isArray(dataAll.tools)) totalApps = dataAll.tools.length;
  }
} catch {}


// 3) Filas de categorías (grupos de 5) — construir DESPUÉS de tener `categorias`
const categoryRows: string[][] = [];
for (let i = 0; i < categorias.length; i += 5) {
  categoryRows.push(categorias.slice(i, i + 5));
}

// 4) Top 5 por categoría + conteo total para "Ver todas (n)"
const conteosPorCategoria: Record<string, number> =
  Object.fromEntries(categorias.map((c) => [c, 0]));

const appFetches: { categoria: string; apps: App[] }[] = [];

for (const categoria of categorias) {
  let apps: App[] = [];

  // Top 5
  try {
    const resTop = await fetch(
      `https://queesia.com/api/obtener_datos.php?category=${encodeURIComponent(
        categoria
      )}&limit=5&top=1&_nocache=${Date.now()}`
    );
    if (resTop.ok) {
      const dataTop = await resTop.json();
      apps = Array.isArray(dataTop.tools) ? (dataTop.tools as App[]) : [];
    }
  } catch {}

  // Conteo total por categoría
  try {
    const resCount = await fetch(
      `https://queesia.com/api/obtener_datos.php?category=${encodeURIComponent(
        categoria
      )}&all=1&_nocache=${Date.now()}`
    );
    if (resCount.ok) {
      const dataCount = await resCount.json();
      conteosPorCategoria[categoria] = Array.isArray(dataCount.tools)
        ? dataCount.tools.length
        : 0;
    }
  } catch {}

  appFetches.push({ categoria, apps });
}

// 5) appsByCategoria preservando el orden original
const appsByCategoria: Record<string, App[]> = Object.fromEntries(
  categorias.map((c) => [c, [] as App[]])
);

for (const { categoria, apps } of appFetches) {
  appsByCategoria[categoria] = apps;
}


const API_BASE = "https://queesia.com/api";
const NEW_SINCE_ID = 1475;

let nuevasApps: App[] = [];

try {
  const resNuevas = await fetch(
    `${API_BASE}/obtener_datos.php?new_since_id=${NEW_SINCE_ID}&limit=4`,
    { headers: { Accept: "application/json" } }
  );

  const dataNuevas = await resNuevas.json();

  if (dataNuevas?.success && Array.isArray(dataNuevas.tools)) {
    nuevasApps = dataNuevas.tools as App[];
  }
} catch (error) {
  console.error("Error cargando apps nuevas:", error);
}

