<!-- Animación + actualización dinámica del conteo -->
<script is:inline>
  (function () {
    const els = document.querySelectorAll(".countup");
    const ease = t => 1 - Math.pow(1 - t, 3);

    function animate(el, to) {
      const dur = 800;
      const from = 0;
      const start = performance.now();

      function step(now) {
        const p = Math.min(1, (now - start) / dur);
        el.textContent = Math.floor(from + (to - from) * ease(p));
        if (p < 1) requestAnimationFrame(step);
      }

      requestAnimationFrame(step);
    }

    async function loadDynamicMetrics() {
      try {
        const [appsRes, categoriesRes] = await Promise.all([
          fetch("https://queesia.com/api/obtener_datos.php?all=1&limit=5000&page=1&_nocache=" + Date.now()),
          fetch("https://queesia.com/api/obtener_categorias.php?_nocache=" + Date.now())
        ]);

        const appsData = await appsRes.json();
        const categoriesData = await categoriesRes.json();

        const totalApps =
          typeof appsData.total === "number"
            ? appsData.total
            : Array.isArray(appsData.tools)
              ? appsData.tools.length
              : null;

        const totalCategories =
          categoriesData?.success && Array.isArray(categoriesData.categories)
            ? categoriesData.categories.length
            : null;

        els.forEach((el) => {
          const metric = el.getAttribute("data-metric");

          if (metric === "apps" && totalApps !== null) {
            el.setAttribute("data-countto", String(totalApps));
          }

          if (metric === "categories" && totalCategories !== null) {
            el.setAttribute("data-countto", String(totalCategories));
          }
        });
      } catch (error) {
        console.error("Error cargando métricas dinámicas:", error);
      }
    }

    loadDynamicMetrics().finally(() => {
      const io = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            const el = e.target;
            const to = parseInt(el.getAttribute("data-countto") || "0", 10);
            animate(el, isNaN(to) ? 0 : to);
            io.unobserve(el);
          }
        });
      }, { threshold: 0.5 });

      els.forEach(el => io.observe(el));
    });
  })();
</script>

      
