---
type Tone = 'blue' | 'cyan' | 'indigo';
type Variant = 'catalog' | 'hero';

interface Props {
  variant?: Variant;
  tone?: Tone;
}

const { variant = 'catalog', tone = 'blue' } = Astro.props as Props;

const colors: Record<Tone, { line: string; fill: string }> = {
blue:   { line: 'stroke-blue-500/50',   fill: 'fill-blue-500/10'   },
cyan:   { line: 'stroke-cyan-500/50',   fill: 'fill-cyan-500/10'   },
indigo: { line: 'stroke-indigo-500/50', fill: 'fill-indigo-500/10' },

};

const c = colors[tone];
---

<div class="deco-layer" aria-hidden="true">
  <!-- Arcos tecnológicos -->
  <svg
    aria-hidden="true"
    viewBox="0 0 1600 700"
    preserveAspectRatio="xMidYMid slice"
    class="deco-item w-[1600px] h-[700px] left-1/2 -translate-x-1/2 -top-16"
    data-parallax
    data-speed="0.18"
  >
    <defs>
      <linearGradient id={`g-${tone}`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="currentColor" stop-opacity="0.5" />
        <stop offset="100%" stop-color="currentColor" stop-opacity="0.0" />
      </linearGradient>
    </defs>

    <g class="text-blue-500/50">
      <path d="M50,520 C350,380 850,380 1150,520" class={`fill-none ${c.line}`} stroke-width="2" />
      <path d="M50,560 C420,430 780,430 1150,560" class={`fill-none ${c.line}`} stroke-width="2" />
      <path d="M120,580 C500,470 700,470 1080,580" class={`fill-none ${c.line}`} stroke-width="1.5" />
    </g>

    <!-- Nodos -->
    <circle cx="260" cy="480" r="5" class={c.fill} />
    <circle cx="940" cy="490" r="6" class={c.fill} />
    <circle cx="600" cy="460" r="4" class={c.fill} />
  </svg>

  <!-- Malla de circuitos sutil al fondo -->
  <svg
    aria-hidden="true"
   viewBox="0 0 1600 700"
    preserveAspectRatio="xMidYMid slice"
    class="deco-item w-[1600px] h-[700px] left-1/2 -translate-x-1/2 top-0 opacity-70"
    data-parallax
    data-speed="0.08"
  >
    <g class="stroke-gray-500/25">
      <!-- grid -->
      <path d="M0 120 H1600 M0 240 H1600 M0 360 H1600 M0 480 H1600 M0 600 H1600" stroke-width="1" />
      <path d="M120 0 V700 M360 0 V700 M600 0 V700 M840 0 V700 M1080 0 V700 M1320 0 V700" stroke-width="1" />
      <!-- trazos -->
      <path d="M300 180 C360 160, 440 160, 500 180" stroke-width="2" class={c.line} />
      <path d="M700 420 C780 380, 920 380, 1000 420" stroke-width="2" class={c.line} />
    </g>
  </svg>
</div>
